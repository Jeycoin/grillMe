{
  "name": "interview-aiagent",
  "productName": "拷问官",
  "version": "0.1.0",
  "description": "AI 面试官 —— 实时语音对练 + 长期记忆 + 面经定向拷打",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "npm run build && node server/index.js --serve-web",
    "typecheck": "tsc --noEmit",
    "e2e:voice": "node scripts/voice-e2e.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "openai": "^7.17.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.7.3",
    "vite": "^8.3.0"
  }
}
